{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Noren Support Hub",
  "colors": {
    "primary": "#0B1730",
    "light": "#1764D8",
    "dark": "#0B1730"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "welcome",
          "terms",
          "refunds"
        ]
      },
      {
        "group": "Products",
        "pages": [
          {
            "group": "Nametags",
            "pages": [
              "untitled-page"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/images/Logo_Rounded.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://noren.arcroblox.work"
    }
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "background": {
    "decoration": "gradient"
  },
  "icons": {
    "library": "fontawesome"
  },
  "metadata": {
    "timestamp": true
  },
  "description": "Noren's Official Support Hub",
  "banner": {
    "content": "Welcome to Noren's new Support Hub, designed to help you even better.",
    "dismissible": true
  },
  "favicon": {
    "light": "/images/Logo_Circle.png",
    "dark": "/images/Logo_Circle.png"
  },
  "thumbnails": {
    "fonts": {
      "family": "Plus Jakarta Sans"
    }
  }
}
